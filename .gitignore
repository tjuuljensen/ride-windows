# git ignore file
*.bak

# Exclude libraries
dev/*

# Exclude Visual Studio meta
.vs/*

# exclude ini files
config.ini
serials.ini

# Exclude local/private presets and logs
private.preset
*.private.preset
install-log.log

# Transient lock for the append-only acquisition evidence library.
catalog/artifact-observations.json.lock

# Optional checkout-local user/company configuration; never a release default.
.local/
